rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isPro() {
      return isAdmin() || (signedIn()
        && exists(/databases/$(database)/documents/entitlements/$(request.auth.uid))
        && get(/databases/$(database)/documents/entitlements/$(request.auth.uid)).data.pro == true);
    }

    // Progress: each user reads/writes only their own doc
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // Own lessons (pasted text / YouTube): creating needs Pro
    match /users/{uid}/lessons/{lessonId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && isPro();
    }
    // Free video lessons: everyone can read, only admins publish
    match /publicLessons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Plan flags: set only from the Firebase console (or a future payment backend)
    match /entitlements/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
